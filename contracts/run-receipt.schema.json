{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "operation", "status", "source", "started_at", "completed_at", "input_sha256", "output_sha256", "exit_code", "detail"],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "status": { "enum": ["NOT_RUN", "RUNNING", "PASS", "FAIL", "ABORTED", "UNSUPPORTED", "STALE"] },
    "source": { "enum": ["DETERMINISTIC_LOCAL", "NATIVE_PROCESS", "FILESYSTEM", "TEST_FIXTURE", "USER_ACTION"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "engine_commit": { "type": ["string", "null"] },
    "executable_sha256": { "type": ["string", "null"] },
    "input_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "output_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "exit_code": { "type": ["integer", "null"] },
    "detail": { "type": "string" }
  },
  "additionalProperties": false
}
